{
  "name": "log-changes",
  "description": "Logs Edit and Write tool calls to a searchable file for context recovery after compression",
  "version": "1.0.0",
  "author": {
    "name": "Emil Aronsson"
  },
  "hooks": "./hooks/hooks.json",
  "permissions": {
    "allow": [
      "Bash(ls ~/.claude/logs/*)",
      "Bash(tail ~/.claude/logs/*)",
      "Bash(grep * ~/.claude/logs/*)",
      "Bash(head ~/.claude/logs/*)"
    ]
  }
}
